# Copiar a .env.local y rellenar con los valores de
# Supabase → Settings → API

# Públicas: viajan al navegador. Por eso RLS no es opcional.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO local, solo para los scripts de semilla.
# Salta toda la RLS. Nunca en Vercel, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
